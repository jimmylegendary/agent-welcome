{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-welcome.local/schemas/observation.schema.json",
  "title": "Setup environment observations",
  "description": "kernel_os identifies the running process kernel environment; host_os is the physical host only when positively identified and otherwise null.",
  "type": "object",
  "properties": {
    "kernel_os": {"type": ["string", "null"]},
    "host_os": {"type": ["string", "null"]},
    "architecture": {"type": ["string", "null"]},
    "runtime_kind": {"type": ["string", "null"]},
    "libc": {
      "type": ["object", "null"],
      "properties": {
        "family": {"type": ["string", "null"], "enum": ["glibc", "musl", "bionic", null]},
        "version": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]+)*$"}
      },
      "additionalProperties": true
    },
    "capabilities": {"type": ["object", "null"]},
    "auth": {"type": ["object", "null"]},
    "sandbox": {
      "type": ["object", "null"],
      "properties": {
        "enabled": {"type": ["boolean", "null"]},
        "backend": {"type": ["string", "null"]},
        "permission_profile": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "provenance": {"type": ["object", "null"]}
  },
  "additionalProperties": true
}
